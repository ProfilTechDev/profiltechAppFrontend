# =============================================================================
# Development defaults
#
# Copy to .env (gitignored) and adjust. Nuxt automatically loads .env at dev
# and build time. At runtime in Docker / Dokploy, the same NUXT_* env vars
# override `runtimeConfig` values directly — no .env file inside the image.
# =============================================================================

# Where the Nitro server binds inside the container
HOST=0.0.0.0
PORT=3000

# -----------------------------------------------------------------------------
# Sanctum baseUrl — split into server-side and browser-side because Nitro
# (SSR) reads `runtimeConfig.sanctum` while the browser reads
# `runtimeConfig.public.sanctum`. In production this lets SSR talk to the API
# over the internal Docker network and the browser use the public domain.
# -----------------------------------------------------------------------------

# Server-side (Nitro SSR → Laravel API)
# Dev: same as public. Prod: internal Dokploy service name, e.g. http://profiltech-api
NUXT_SANCTUM_BASE_URL=http://localhost:8000

# Browser-side (client → Laravel API). Must be reachable from a user's browser.
# Dev: same as server. Prod: public domain, e.g. https://api.profiltech.dk
NUXT_PUBLIC_SANCTUM_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Laravel Reverb (WebSocket broadcasting). All values are public — they are
# embedded in the client bundle. Must match REVERB_APP_KEY / REVERB_HOST /
# REVERB_PORT / REVERB_SCHEME on the backend.
# -----------------------------------------------------------------------------
NUXT_PUBLIC_REVERB_APP_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http
